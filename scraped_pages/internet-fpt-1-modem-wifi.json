ns'); for (var w = 0; wraps.length > w; w++) { setup(wraps[w]); } function setup(wrap){ var track = wrap.querySelector('.fpt-np-track'), box = wrap.querySelector('.fpt-np-dots'); if (!track || !box) return; var cards = track.children, btns = [], ticking = false; function pad(){ return parseInt(getComputedStyle(track).paddingLeft, 10) || 0; } for (var i = 0; cards.length > i; i++) { (function(k){ var b = document.createElement('button'); b.type = 'button'; b.setAttribute('aria-label', 'Xem gói ' + (k + 1)); b.addEventListener('click', function(){ track.scrollTo({ left: cards[k].offsetLeft - pad(), behavior: 'smooth' }); }); box.appendChild(b); btns.push(b); })(i); } function update(){ var best = 0, dist = 1e9, x = track.scrollLeft + pad(); for (var i = 0; cards.length > i; i++) { var d = Math.abs(cards[i].offsetLeft - x); if (dist > d) { dist = d; best = i; } } if (track.scrollLeft + track.clientWidth + 4 >= track.scrollWidth) { best = cards.length - 1; } for (var j = 0; btns.length > j; j++) { btns[j].className = j === best ? 'is-on' : ''; } } track.addEventListener('scroll', function(){ if (ticking) return; ticking = true; requestAnimationFrame(function(){ update(); ticking = false; }); }, { passive: true }); update(); } })(); </script> <script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Trang chủ\", \"item\": \"https://fpt-telecom.com.vn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Internet cáp quang FPT\", \"item\": \"https://fpt-telecom.com.vn/dich-vu-internet-fpt/\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Gói 1 Modem WiFi\", \"item\": \"https://fpt-telecom.com.vn/internet-fpt-1-modem-wifi/\"}]}</script> <script type=\"application/ld+json\"> {\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Gói Internet FPT 1 Modem WiFi\",\"serviceType\":\"Internet cáp quang FTTH\",\"url\":\"https: