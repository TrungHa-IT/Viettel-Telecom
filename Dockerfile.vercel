# Vercel selects this file before the standard Next.js framework detector.
# Keep this image aligned with Dockerfile so local and Vercel builds use the
# same Node.js runtime and native better-sqlite3 build dependencies.
FROM node:22-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --include=dev

COPY . .
RUN npm run build
RUN npm prune --omit=dev
RUN mkdir -p /app/data

EXPOSE 3000

CMD ["npm", "start"]
