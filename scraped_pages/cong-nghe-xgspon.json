ext-center\"  >\n\t\t\t\n\t\t\t\n<h2><span style=\"color: #ff3300;\"><strong>SO SÁNH <span style=\"color: #4285f4;\">XGSPON</span> VỚI PON</strong></span></h2>\n<p>Đậm chất công nghệ, mang đến trải nghiệm tuyệt vời nhất.</p>\n\t\t</div>\n\t\t\t\t\n<style>\n#col-640425856 > .col-inner {\n  margin: 0px 0px -10px 0px;\n}\n</style>\n\t</div>\n\n\t\n</div>\n<div class=\"row row-box-shadow-1 row-box-shadow-3-hover\"  id=\"row-970653871\">\n\n\t<div id=\"col-741937880\" class=\"col medium-4 small-12 large-4\"  data-animate=\"fadeInUp\">\n\t\t\t\t<div class=\"col-inner\"  >\n\t\t\t\n\t<div class=\"is-border\"\n\t\tstyle=\"border-color:rgb(225, 77, 67);border-radius:10px;border-width:1px 1px 1px 1px;\">\n\t</div>\n\t\t\t\n\n\t\t<div class=\"icon-box featured-box icon-box-center text-center\"  >\n\t\t\t\t\t<div class=\"icon-box-img\" style=\"width: 80px\">\n\t\t\t\t<div class=\"icon\">\n\t\t\t\t\t<div class=\"icon-inner\" >\n\t\t\t\t\t\t<img decoding=\"async\" width=\"120\" height=\"120\" src=\"https://fpt-telecom.com.vn/wp-content/uploads/2025/04/wifi-icon.png\" class=\"attachment-medium size-medium\" alt=\"wifi-icon\" />\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t<div class=\"icon-box-text last-reset\">\n\t\t\t\t\t\t\t\t\t\n\t<div id=\"text-2345945515\" class=\"text\">\n\t\t\n<h3 style=\"text-align: center;\"><span style=\"font-family: 'andale mono', monospace;\">Tốc độ Internet siêu vượt trội</span></h3>\n<p>Mang đến trải nghiệm streaming, làm việc và giải trí mượt mà ở tốc độ 10 Gbps &#8211; ngay cả khi nhiều thiết bị cùng kết nối.</p>\n\t\t\n<style>\n#text-2345945515 {\n  text-align: center;\n  color: rgb(0,0,0);\n}\n#text-2345945515 > * {\n  color: rgb(0,0,0);\n}\n</style>\n\t</div>\n\t\n\t\t</div>\n\t</div>\n\t\n\t\n\t\t</div>\n\t\t\t\t\t</div>\n\n\t\n\n\t<div id=\"col-199728665\" class=\"col medium-4 small-12 large-4\"  data-animate=\"fadeInUp\">\n\t\t\t\t<div class=\"col-inner\"  >\n\t\t\t\n\t<div class=\"is-border\"\n\t\tstyle=\"border-color:rgb(225, 77, 67);border-radius:10px;border-width:1px 1px 1px 1px;\">\n\t</div>\n\t\t\t\n\n\t\t<div class=\"icon-box featured-box icon-box-center text-center\"  >\n\t\t\t\t\t<div class=\"icon-box-img\" style=\"width: 80px\">\n\t\t\t\t<div class=\"icon\">\n\t\t\t\t\t<div class=\"icon-inner\" >\n\t\t\t\t\t\t<img decoding=\"async\" width=\"120\" height=\"120\" src=\"https://fpt-telecom.com.vn/wp-content/uploads/2025/04/connect-icon.png\" class=\"attachment-medium size-medium\" alt=\"connect-icon\" />\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t<div class=\"icon-box-text last-reset\">\n\t\t\t\t\t\t\t\t\t\n\t<div id=\"text-2426151154\" class=\"text\">\n\t\t\n<h3 style=\"text-align: center;\"><span style=\"font-family: 'andale mono', monospace;\">Hiệu suất tối đa</span></h3>\n<p>Với XGSPON đa nhiệm trở nên dễ dàng hơn bao giờ hết. Việc gửi hay truy cập các tệp dữ liệu lớn giờ chỉ mất vài giây.</p>\n\t\t\n<style>\n#text-2426151154 {\n  text-align: center;\n  color: rgb(0,0,0);\n}\n#text-2426151154 > * {\n  color: rgb(0,0,0);\n}\n</style>\n\t</div>\n\t\n\t\t</div>\n\t</div>\n\t\n\t\n\t\t</div>\n\t\t\t\t\t</div>\n\n\t\n\n\t<div id=\"col-1678306274\" class=\"col medium-4 small-12 large-4\"  data-animate=\"fadeInUp\">\n\t\t\t\t<div class=\"col-inner\"  >\n\t\t\t\n\t<div class=\"is-border\"\n\t\tstyle=\"border-color:rgb(225, 77, 67);border-radius:10px;border-width:1px 1px 1px 1px;\">\n\t</div>\n\t\t\t\n\n\t\t<div class=\"icon-box featured-box icon-box-center text-center\"  >\n\t\t\t\t\t<div class=\"icon-box-img\" style=\"width: 80px\">\n\t\t\t\t<div class=\"icon\">\n\t\t\t\t\t<div class=\"icon-inner\" >\n\t\t\t\t\t\t<img decoding=\"async\" width=\"120\" height=\"120\" src=\"https://fpt-telecom.com.vn/wp-content/uploads/2025/04/phu-song-icon.png\" class=\"attachment-medium size-medium\" alt=\"phu-song-icon\" />\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t<div class=\"icon-box-text last-reset\">\n\t\t\t\t\t\t\t\t\t\n\t<div id=\"text-1023807258\" class=\"text\">\n\t\t\n<h3 style=\"text-align: center;\"><span style=\"font-family: 'andale mono', monospace;\">Sẵn sàng cho tương lai</span></h3>\n<p>Hạ tầng XGSPON được thiết kế để đáp ứng nhu cầu dữ liệu ngày càng tăng và hỗ trợ các công nghệ tương lai như <a href=\"https://fpt-telecom.com.vn/fpt-wifi-7/\"><strong>Wi-Fi 7</strong></a>.</p>\n\t\t\n<style>\n#text-1023807258 {\n  text-align: center;\n  color: rgb(0,0,0);\n}\n#text-1023807258 > * {\n  color: rgb(0,0,0);\n}\n</style>\n\t</div>\n\t\n\t\t</div>\n\t</div>\n\t\n\t\n\t\t</div>\n\t\t\t\t\t</div>\n\n\t\n\n<style>\n#row-970653871 > .col > .col-inner {\n  padding: 10px 10px 10px 10px;\n  border-radius: 10px;\n}\n</style>\n</div>\n\t\t</div>\n\n\t\t\n<style>\n#section_514581465 {\n  padding-top: 30px;\n  padding-bottom: 30px;\n}\n</style>\n\t</section>\n\t\n\t<section class=\"section\" id=\"section_1500628980\">\n\t\t<div class=\"bg section-bg fill bg-fill  bg-loaded\" >\n\n\t\t\t\n\t\t\t\n\t\t\t\n\n\t\t</div>\n\n\t\t<div class=\"section-content relative\">\n\t\t\t\n<div class=\"row\"  id=\"row-1016700874\">\n\n\t<div id=\"col-472029790\" class=\"col small-12 large-12\"  >\n\t\t\t\t<div class=\"col-inner text-center\"  >\n\t\t\t\n\t\t\t\n<h2><span style=\"color: #ff3300;\"><strong>VÌ SAO NÊN LỰA CHỌN <span style=\"color: #3366ff;\">XGSPON</span></strong></span></h2>\n<p><strong>XGS-PON</strong> là nền tảng cho kỷ nguyên số – giúp Internet trở thành động lực chính cho kinh tế, học tập và giải trí</p>\n\t\t</div>\n\t\t\t\t\n<style>\n#col-472029790 > .col-inner {\n  margin: 0px 0px -10px 0px;\n}\n</style>\n\t</div>\n\n\t\n</div>\n<div class=\"row row-box-shadow-2-hover\"  id=\"row-1886217592\">\n\n\t<div id=\"col-1820642976\" class=\"col medium-6 small-12 large-6\"  data-animate=\"fadeInUp\">\n\t\t\t\t<div class=\"col-inner\"  >\n\t\t\t\n\t<div class=\"is-border\"\n\t\tstyle=\"border-radius:20px;border-width:1px 1px 1px 1px;\">\n\t</div>\n\t\t\t\n\n\t\t<div class=\"icon-box featured-box icon-box-top text-left\"  >\n\t\t\t\t\t<div class=\"icon-box-img\" style=\"width: 55px\">\n\t\t\t\t<div class=\"icon\">\n\t\t\t\t\t<div class=\"icon-inner\" >\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t<div class=\"icon-box-text last-reset\">\n\t\t\t\t\t\t\t\t\t\n\t<div id=\"text-3744171900\" class=\"text\">\n\t\t\n<h3><span style=\"color: #4285f4;\">Tốc độ siêu cao và đối xứng</span></h3>\n<p>Download: 10 Gbps / Upload: 10 Gbps, nhanh gấp nhiều lần GPON.</p>\n<p>Đặc biệt hữu ích cho doanh nghiệp, trung tâm dữ liệu, livestream, video call, cloud gaming… khi cần upload mạnh như download.</p>\n\t\t\n<style>\n#text-3744171900 {\n  color: rgb(0,0,0);\n}\n#text-3744171900 > * {\n  color: rgb(0,0,0);\n}\n</style>\n\t</div>\n\t\n\t\t</div>\n\t</div>\n\t\n\t\n\t\t</div>\n\t\t\t\t\t</div>\n\n\t\n\n\t<div id=\"col-1240130814\" class=\"col medium-6 small-12 large-6\"  data-animate=\"fadeInUp\">\n\t\t\t\t<div class=\"col-inner\"  >\n\t\t\t\n\t<div class=\"is-border\"\n\t\tstyle=\"border-radius:20px;border-width:1px 1px 1px 1px;\">\n\t</div>\n\t\t\t\n\n\t\t<div class=\"icon-box featured-box icon-box-top text-left\"  >\n\t\t\t\t\t<div class=\"icon-box-img\" style=\"width: 55px\">\n\t\t\t\t<div class=\"icon\">\n\t\t\t\t\t<div class=\"icon-inner\" >\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t<div class=\"icon-box-text last-reset\">\n\t\t\t\t\t\t\t\t\t\n\t<div id=\"text-1038645318\" class=\"text\">\n\t\t\n<h3><span style=\"color: #34a853;\">Đáp ứng nhu cầu Internet hiện đại</span></h3>\n<p>Hỗ trợ Smart City, IoT, Cloud Services, 5G Backhaul.</p>\n<p>Truyền tải mượt mà các ứng dụng nặng băng thông: 4K/8K video, VR/AR, hội nghị trực tuyến chất lượng cao.</p>\n\t\t\n<style>\n#text-1038645318 {\n  color: rgb(0,0,0);\n}\n#text-1038645318 > * {\n  color: rgb(0,0,0);\n}\n</style>\n\t</div>\n\t\n\t\t</div>\n\t</div>\n\t\n\t\n\t\t</div>\n\t\t\t\t\t</div>\n\n\t\n\n\t<div id=\"col-1919243951\" class=\"col medium-6 small-12 large-6\"  data-animate=\"fadeInUp\">\n\t\t\t\t<div class=\"col-inner\"