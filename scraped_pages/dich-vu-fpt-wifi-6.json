idth:1px 1px 1px 1px;\">\n\t</div>\n\t\t\t\n\n\t\t<div class=\"icon-box featured-box icon-box-center text-center\"  >\n\t\t\t\t\t<div class=\"icon-box-img\" style=\"width: 80px\">\n\t\t\t\t<div class=\"icon\">\n\t\t\t\t\t<div class=\"icon-inner\" >\n\t\t\t\t\t\t<img decoding=\"async\" width=\"120\" height=\"120\" src=\"https://fpt-telecom.com.vn/wp-content/uploads/2025/04/connect-icon.png\" class=\"attachment-medium size-medium\" alt=\"connect-icon\" />\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t<div class=\"icon-box-text last-reset\">\n\t\t\t\t\t\t\t\t\t\n\t<div id=\"text-3862766588\" class=\"text\">\n\t\t\n<h3 style=\"text-align: center;\"><span style=\"font-family: 'andale mono', monospace;\">KẾT NỐI VƯỢT TRỘI</span></h3>\n<p>Sóng Internet rộng hơn, nhanh hơn, mạnh hơn gấp 4 lần.</p>\n\t\t\n<style>\n#text-3862766588 {\n  text-align: center;\n  color: rgb(0,0,0);\n}\n#text-3862766588 > * {\n  color: rgb(0,0,0);\n}\n</style>\n\t</div>\n\t\n\t\t</div>\n\t</div>\n\t\n\t\n\t\t</div>\n\t\t\t\t\t</div>\n\n\t\n\n\t<div id=\"col-1226791783\" class=\"col medium-4 small-12 large-4\"  data-animate=\"fadeInUp\">\n\t\t\t\t<div class=\"col-inner\"  >\n\t\t\t\n\t<div class=\"is-border\"\n\t\tstyle=\"border-color:rgb(225, 77, 67);border-radius:10px;border-width:1px 1px 1px 1px;\">\n\t</div>\n\t\t\t\n\n\t\t<div class=\"icon-box featured-box icon-box-center text-center\"  >\n\t\t\t\t\t<div class=\"icon-box-img\" style=\"width: 80px\">\n\t\t\t\t<div class=\"icon\">\n\t\t\t\t\t<div class=\"icon-inner\" >\n\t\t\t\t\t\t<img decoding=\"async\" width=\"120\" height=\"120\" src=\"https://fpt-telecom.com.vn/wp-content/uploads/2025/04/phu-song-icon.png\" class=\"attachment-medium size-medium\" alt=\"phu-song-icon\" />\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t<div class=\"icon-box-text last-reset\">\n\t\t\t\t\t\t\t\t\t\n\t<div id=\"text-3666991761\" class=\"text\">\n\t\t\n<h3 style=\"text-align: center;\"><span style=\"font-family: 'andale mono', monospace;\">MỞ RỘN